     1                                  ; fdc_peek.asm -- minimal: read port 0x92 sixteen times, store, print.
     2                                  ; If the FDC is parked mid-drain, each read returns fifo_q (pops) or reply.
     3                                  ; Injected at SEG:0000 via JTAG, triggered through a hijacked vector.
     4                                  ;
     5                                  ; print line: MSR be | b0..b15 | run
     6                                  ; buf/runcount live at SEG:01E0 (same layout as fdc_probe)
     7                                  
     8                                          bits 16
     9                                          org 0
    10                                  
    11                                  start:
    12 00000000 FA                              cli
    13 00000001 50                              push    ax
    14 00000002 53                              push    bx
    15 00000003 51                              push    cx
    16 00000004 52                              push    dx
    17 00000005 1E                              push    ds
    18 00000006 06                              push    es
    19 00000007 56                              push    si
    20 00000008 57                              push    di
    21                                  
    22 00000009 8CC8                            mov     ax, cs
    23 0000000B 8ED8                            mov     ds, ax
    24 0000000D 8EC0                            mov     es, ax
    25 0000000F FE06[9000]                      inc     byte [runcount]
    26                                  
    27                                          ; snapshot MSR + 0xBE
    28 00000013 BA9000                          mov     dx, 0x90
    29 00000016 EC                              in      al, dx
    30 00000017 A2[9100]                        mov     [buf+0], al
    31 0000001A BABE00                          mov     dx, 0xBE
    32 0000001D EC                              in      al, dx
    33 0000001E A2[9200]                        mov     [buf+1], al
    34                                  
    35                                          ; raw reads of the data port, no polling -- whatever comes back, store it
    36 00000021 BF[9300]                        mov     di, buf+2
    37 00000024 B91000                          mov     cx, 16
    38 00000027 BA9200                  .rd:    mov     dx, 0x92
    39 0000002A EC                              in      al, dx
    40 0000002B AA                              stosb
    41 0000002C E2F9                            loop    .rd
    42                                  
    43                                          ; snapshot MSR again after the reads
    44 0000002E BA9000                          mov     dx, 0x90
    45 00000031 EC                              in      al, dx
    46 00000032 A2[A300]                        mov     [buf+18], al
    47                                  
    48                                          ; ---- print ----
    49 00000035 B800A0                          mov     ax, 0xA000
    50 00000038 8EC0                            mov     es, ax
    51 0000003A 31FF                            xor     di, di
    52 0000003C BE[9100]                        mov     si, buf
    53 0000003F B91400                          mov     cx, 20              ; MSR BE b0..b15 MSR2
    54 00000042 AC                      .pb:    lodsb
    55 00000043 89C3                            mov     bx, ax
    56 00000045 C0E804                          shr     al, 4
    57 00000048 E82900                          call    putnib
    58 0000004B 88D8                            mov     al, bl
    59 0000004D E82400                          call    putnib
    60 00000050 B020                            mov     al, ' '
    61 00000052 E82900                          call    putch
    62 00000055 E2EB                            loop    .pb
    63                                  
    64 00000057 A0[9000]                        mov     al, [runcount]
    65 0000005A 89C3                            mov     bx, ax
    66 0000005C C0E804                          shr     al, 4
    67 0000005F E81200                          call    putnib
    68 00000062 88D8                            mov     al, bl
    69 00000064 E80D00                          call    putnib
    70                                  
    71                                          ; EOI so IRQ1 can fire again (we preempted the BIOS handler)
    72 00000067 B020                            mov     al, 0x20
    73 00000069 E600                            out     0x00, al
    74                                  
    75 0000006B 5F                              pop     di
    76 0000006C 5E                              pop     si
    77 0000006D 07                              pop     es
    78 0000006E 1F                              pop     ds
    79 0000006F 5A                              pop     dx
    80 00000070 59                              pop     cx
    81 00000071 5B                              pop     bx
    82 00000072 58                              pop     ax
    83 00000073 CF                              iret
    84                                  
    85                                  ; ---------------------------------------------------------------- helpers
    86                                  putnib:
    87 00000074 240F                            and     al, 0x0F
    88 00000076 0430                            add     al, '0'
    89 00000078 3C39                            cmp     al, '9'
    90 0000007A 7602                            jbe     putch
    91 0000007C 0407                            add     al, 'A'-'9'-1
    92                                  putch:
    93 0000007E 268805                          mov     [es:di], al
    94 00000081 26C6450100                      mov     byte [es:di+1], 0
    95 00000086 26C6850020E1                    mov     byte [es:di+0x2000], 0xE1
    96 0000008C 83C702                          add     di, 2
    97 0000008F C3                              ret
    98                                  
    99                                          align 16
   100 00000090 00                      runcount: db 0
   101 00000091 00<rep 18h>             buf:      times 24 db 0
   102                                  
   103 000000A9 90<rep 57h>                     align 256
   104                                  sector_buf:
