     1                                  ; fdc_ipl.asm -- IPL that re-reads C0/H0/R1 via FDC PIO (ndma) and stashes the
     2                                  ; sector at 0x4000:0000 for JTAG dump, so "upstream of the DMAC" (dataslot ->
     3                                  ; bridge RAM -> FDC FIFO -> PIO) can be compared byte-for-byte against the
     4                                  ; image, isolating the DMAC write path as the suspect for the dropped bytes
     5                                  ; seen in the DMA-delivered copy at 1FE0:0000.
     6                                  ;
     7                                  ; Must fit the 512-byte IPL window the BIOS actually transfers.
     8                                  ;
     9                                  ; Screen row 0 shows progress marks: I S R D ... P E  (PIO read stages).
    10                                  ; Sector lands at phys 0x40000, result bytes at phys 0x40400.
    11                                  
    12                                          bits 16
    13                                          org 0
    14                                  
    15                                  start:
    16 00000000 FA                              cli
    17 00000001 8CC8                            mov     ax, cs          ; 1FE0
    18 00000003 8ED8                            mov     ds, ax
    19 00000005 B80040                          mov     ax, 0x4000      ; sector lands at phys 0x40000
    20 00000008 8EC0                            mov     es, ax
    21 0000000A 31FF                            xor     di, di
    22                                  
    23 0000000C B049                            mov     al, 'I'
    24 0000000E E87F00                          call    putmark
    25                                  
    26                                          ; ---- FDC soft reset: 0x94 bit7 0->1 edge ----
    27 00000011 BA9400                          mov     dx, 0x94
    28 00000014 30C0                            xor     al, al
    29 00000016 EE                              out     dx, al
    30 00000017 B90030                          mov     cx, 0x3000
    31 0000001A E2FE                    .d0:    loop    .d0
    32 0000001C B080                            mov     al, 0x80
    33 0000001E EE                              out     dx, al
    34 0000001F B90030                          mov     cx, 0x3000
    35 00000022 E2FE                    .d1:    loop    .d1
    36                                  
    37                                          ; ---- SPECIFY (ndma): 03 DF 03 ----
    38 00000024 B053                            mov     al, 'S'
    39 00000026 E86700                          call    putmark
    40 00000029 E88900                          call    wcmd
    41 0000002C B003                            mov     al, 0x03
    42 0000002E E89100                          call    wd92
    43 00000031 E88100                          call    wcmd
    44 00000034 B0DF                            mov     al, 0xDF
    45 00000036 E88900                          call    wd92
    46 00000039 E87900                          call    wcmd
    47 0000003C B003                            mov     al, 0x03
    48 0000003E E88100                          call    wd92
    49                                  
    50                                          ; ---- READ DATA: 46 00 00 00 01 03 08 1B FF ----
    51 00000041 B052                            mov     al, 'R'
    52 00000043 E84A00                          call    putmark
    53 00000046 BE[CB00]                        mov     si, cmd
    54 00000049 B90900                          mov     cx, 9
    55 0000004C E86600                  .sc:    call    wcmd
    56 0000004F AC                              lodsb
    57 00000050 E86F00                          call    wd92
    58 00000053 E2F7                            loop    .sc
    59                                  
    60 00000055 B044                            mov     al, 'D'
    61 00000057 E83600                          call    putmark
    62                                  
    63                                          ; ---- drain 1024 bytes to ES:0000 (phys 0x40000) ----
    64 0000005A 31FF                            xor     di, di
    65 0000005C B90004                          mov     cx, 1024
    66 0000005F BA9000                  .rd:    mov     dx, 0x90
    67 00000062 EC                              in      al, dx
    68 00000063 24C0                            and     al, 0xC0
    69 00000065 3CC0                            cmp     al, 0xC0
    70 00000067 75F6                            jne     .rd
    71 00000069 BA9200                          mov     dx, 0x92
    72 0000006C EC                              in      al, dx
    73 0000006D AA                              stosb
    74 0000006E E2EF                            loop    .rd
    75                                  
    76                                          ; ---- 7 result bytes to ES:0400 (phys 0x40400) ----
    77 00000070 B050                            mov     al, 'P'
    78 00000072 E81B00                          call    putmark
    79 00000075 B90700                          mov     cx, 7
    80 00000078 BA9000                  .rs:    mov     dx, 0x90
    81 0000007B EC                              in      al, dx
    82 0000007C 24C0                            and     al, 0xC0
    83 0000007E 3CC0                            cmp     al, 0xC0
    84 00000080 75F6                            jne     .rs
    85 00000082 BA9200                          mov     dx, 0x92
    86 00000085 EC                              in      al, dx
    87 00000086 AA                              stosb
    88 00000087 E2EF                            loop    .rs
    89                                  
    90 00000089 B045                            mov     al, 'E'
    91 0000008B E80200                          call    putmark
    92                                  
    93 0000008E EBFE                    hang:   jmp     hang
    94                                  
    95                                  ; ---------------------------------------------------------------- helpers
    96                                  ; putmark: AL -> next TVRAM cell (advances markpos). Preserves everything.
    97                                  putmark:
    98 00000090 06                              push    es
    99 00000091 57                              push    di
   100 00000092 50                              push    ax                      ; char on top: pop order is ax,di,es
   101 00000093 B800A0                          mov     ax, 0xA000
   102 00000096 8EC0                            mov     es, ax
   103 00000098 2E8B3E[C900]                    mov     di, [cs:markpos]
   104 0000009D 58                              pop     ax                      ; restore AL before the store
   105 0000009E 268805                          mov     [es:di], al
   106 000000A1 26C6450100                      mov     byte [es:di+1], 0
   107 000000A6 26C6850020E1                    mov     byte [es:di+0x2000], 0xE1
   108 000000AC 2E8306[C900]02                  add     word [cs:markpos], 2
   109 000000B2 5F                              pop     di
   110 000000B3 07                              pop     es
   111 000000B4 C3                              ret
   112                                  
   113                                  ; wcmd: poll MSR bit7=1 bit6=0 before writing a command/param byte
   114                                  wcmd:
   115 000000B5 52                              push    dx
   116 000000B6 BA9000                          mov     dx, 0x90
   117 000000B9 EC                      .wc:    in      al, dx
   118 000000BA 24C0                            and     al, 0xC0
   119 000000BC 3C80                            cmp     al, 0x80
   120 000000BE 75F9                            jne     .wc
   121 000000C0 5A                              pop     dx
   122 000000C1 C3                              ret
   123                                  
   124                                  ; wd92: write AL to data port
   125                                  wd92:
   126 000000C2 52                              push    dx
   127 000000C3 BA9200                          mov     dx, 0x92
   128 000000C6 EE                              out     dx, al
   129 000000C7 5A                              pop     dx
   130 000000C8 C3                              ret
   131                                  
   132 000000C9 0000                    markpos: dw 0
   133 000000CB 460000000103011BFF      cmd:     db 0x46, 0x00, 0x00, 0x00, 0x01, 0x03, 0x01, 0x1B, 0xFF
   134                                  
   135 000000D4 90<rep 12Ah>                    times 510-($-$$) db 0x90        ; pad inside the guaranteed window
   136 000001FE EBFE                            db 0xEB, 0xFE                   ; safety net at the window's tail
